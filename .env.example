# ─────────────────────────────────────────────
# Waleion — Environment / API keys
# ─────────────────────────────────────────────

# Public site URL (SEO, sitemap, absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form → Google Apps Script web app URL
# Deploy scripts/google-apps-script.js as a Web app, then paste the URL
GOOGLE_APPS_SCRIPT_URL=

# Optional: Google Sheet tab name (default: Leads)
GOOGLE_SHEET_LEADS_TAB=Leads
